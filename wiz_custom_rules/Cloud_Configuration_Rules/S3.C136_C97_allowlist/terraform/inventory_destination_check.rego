package wiz

import data.generic.terraform as terraLib

# --- Configuration ---
# Keep in sync with the cloud matcher. Destinations are matched as literal ARNs.
authorized_inventory_destinations := {
    "arn:aws:s3:::authorized-inventory-bucket",
}

# --- Logic ---
# --- toc-match begin: tf v1 ---
# A Terraform value that is still an unresolved reference ("${...}"). Treat
# it as unknown: never compare it with an allowlist as a string.
tocm_tf_unresolved(v) {
    is_string(v)
    contains(v, "${")
}
# --- toc-match end: tf v1 ---

# --- tf_never_created: begin ---
# A resource with a literal count of 0 or an empty for_each is never created
# and is not judged; any other expression is judged.
tf_expression(v) := trim_space(trim_suffix(trim_prefix(trim_space(v), "${"), "}")) {
    is_string(v)
}

tf_empty_collection := `^(\[\s*\]|\{\s*\}|toset\(\s*(\[\s*\]|\{\s*\})\s*\))$`

tf_zero(v) {
    v == 0
}

tf_zero(v) {
    tf_expression(v) == "0"
}

tf_empty(v) {
    is_array(v)
    count(v) == 0
}

tf_empty(v) {
    is_object(v)
    count(v) == 0
}

tf_empty(v) {
    regex.match(tf_empty_collection, tf_expression(v))
}

tf_not_created(r) {
    tf_zero(object.get(r, "count", null))
}

tf_not_created(r) {
    tf_empty(object.get(r, "for_each", null))
}
# --- tf_never_created: end ---

# --- tf_dynamic: begin ---
# A dynamic block generates blocks the source does not show; one whose
# for_each is a literal empty collection generates nothing. Needs
# tf_never_created.
tf_dynamic_blocks(b, label) := {d |
    d := terraLib.getArray(b.dynamic[_][label])[_]
    is_object(d)
} | {d |
    d := terraLib.getArray(b.dynamic[label])[_]
    is_object(d)
}

tf_dynamic(b, label) {
    d := tf_dynamic_blocks(b, label)[_]
    not tf_empty(object.get(d, "for_each", null))
}
# --- tf_dynamic: end ---

# Destination blocks a dynamic block generates, with each one's searchKey.
tf_dynamic_destinations(inv, name) := {d |
    tf_dynamic(inv, "destination")
    d := {"block": "destination", "key": sprintf("aws_s3_bucket_inventory[%s].dynamic.destination", [name])}
} | {d |
    tf_dynamic(terraLib.getValueArrayOrObject(inv.destination), "bucket")
    d := {"block": "destination.bucket", "key": sprintf("aws_s3_bucket_inventory[%s].destination.dynamic.bucket", [name])}
}

# A destination given by reference is known only at apply and is not compared.
WizPolicy[result] {
    document := input.document[i]
    inv := document.resource.aws_s3_bucket_inventory[name]
    not tf_not_created(inv)
    dest := terraLib.getValueArrayOrObject(inv.destination)
    b := terraLib.getValueArrayOrObject(dest.bucket)
    not tocm_tf_unresolved(b.bucket_arn)
    not authorized_inventory_destinations[b.bucket_arn]

    result := {
        "documentId": document.id,
        "resourceType": "aws_s3_bucket_inventory",
        "resourceName": terraLib.get_resource_name(inv, name),
        "searchKey": sprintf("aws_s3_bucket_inventory[%s].destination.bucket.bucket_arn", [name]),
        "issueType": "IncorrectValue",
        "keyExpectedValue": sprintf("destination bucket_arn must be in the authorized set: %v", [authorized_inventory_destinations]),
        "keyActualValue": sprintf("destination bucket_arn is '%v' (not authorized)", [b.bucket_arn]),
        "resourceTags": terraLib.get_resource_tags(inv),
    }
}

# A dynamic destination cannot be compared, so it is reported.
WizPolicy[result] {
    document := input.document[i]
    inv := document.resource.aws_s3_bucket_inventory[name]
    not tf_not_created(inv)
    d := tf_dynamic_destinations(inv, name)[_]

    result := {
        "documentId": document.id,
        "resourceType": "aws_s3_bucket_inventory",
        "resourceName": terraLib.get_resource_name(inv, name),
        "searchKey": d.key,
        "issueType": "IncorrectValue",
        "keyExpectedValue": sprintf("destination bucket_arn written out, so it can be compared with the authorized set: %v", [authorized_inventory_destinations]),
        "keyActualValue": sprintf("the %s block is generated by a dynamic block, so the destination cannot be compared", [d.block]),
        "resourceTags": terraLib.get_resource_tags(inv),
    }
}
