# S3.C117 (replication_metrics_enabled) - universal - VIOLATING

# Rule with metrics disabled + rule with no metrics block: 2 findings
resource "aws_s3_bucket_replication_configuration" "without_metrics" {
  bucket = "source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "metrics-disabled"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::replica-bucket"

      metrics {
        status = "Disabled"
      }
    }
  }

  rule {
    id     = "metrics-missing"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::replica-bucket-2"
    }
  }
}

# Inline replication_configuration block, rule with metrics disabled + rule
# with no metrics block: 2 findings
resource "aws_s3_bucket" "inline_without_metrics" {
  bucket = "inline-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id       = "inline-metrics-disabled"
      priority = 1
      status   = "Enabled"

      filter {
        prefix = "data/"
      }

      destination {
        bucket = "arn:aws:s3:::replica-bucket"

        metrics {
          status = "Disabled"
        }
      }
    }

    rules {
      id       = "inline-metrics-missing"
      priority = 2
      status   = "Enabled"

      filter {
        prefix = "logs/"
      }

      destination {
        bucket = "arn:aws:s3:::replica-bucket-2"
      }
    }
  }
}

variable "example_enable_replication" {
  type    = bool
  default = false
}

# Metrics disabled with a count from a variable, known only at plan time, so
# it is judged even with a default of false: 1 finding
resource "aws_s3_bucket_replication_configuration" "count_from_variable" {
  count  = var.example_enable_replication ? 1 : 0
  bucket = "source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "metrics-disabled"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::replica-bucket"

      metrics {
        status = "Disabled"
      }
    }
  }
}

variable "example_replication_rules" {
  type = list(object({ id = string, destination_bucket = string }))
}

variable "example_replication_configuration" {
  type = list(object({ role = string, destination_bucket = string }))
}

# Replication rules generated by a dynamic block, which cannot be judged: in
# the standalone resource, in the inline block, and as a whole inline block:
# 3 findings
resource "aws_s3_bucket_replication_configuration" "dyn_standalone" {
  bucket = "dynamic-source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  dynamic "rule" {
    for_each = var.example_replication_rules

    content {
      id     = rule.value.id
      status = "Enabled"

      destination {
        bucket = rule.value.destination_bucket
      }
    }
  }
}

resource "aws_s3_bucket" "dyn_rules_inline" {
  bucket = "dynamic-inline-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    dynamic "rules" {
      for_each = var.example_replication_rules

      content {
        id     = rules.value.id
        status = "Enabled"

        destination {
          bucket = rules.value.destination_bucket
        }
      }
    }
  }
}

resource "aws_s3_bucket" "dyn_whole" {
  bucket = "dynamic-whole-source-bucket"

  dynamic "replication_configuration" {
    for_each = var.example_replication_configuration

    content {
      role = replication_configuration.value.role

      rules {
        id     = "to-replica"
        status = "Enabled"

        destination {
          bucket = replication_configuration.value.destination_bucket
        }
      }
    }
  }
}

variable "example_metrics_statuses" {
  type = list(string)
}

# Metrics block generated by a dynamic block, in the standalone resource and in
# the inline block: 2 findings
resource "aws_s3_bucket_replication_configuration" "dyn_metrics" {
  bucket = "source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "dynamic-metrics"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::replica-bucket"

      dynamic "metrics" {
        for_each = var.example_metrics_statuses

        content {
          status = metrics.value
        }
      }
    }
  }
}

resource "aws_s3_bucket" "dyn_inline_metrics" {
  bucket = "inline-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "dynamic-inline-metrics"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::replica-bucket"

        dynamic "metrics" {
          for_each = var.example_metrics_statuses

          content {
            status = metrics.value
          }
        }
      }
    }
  }
}
