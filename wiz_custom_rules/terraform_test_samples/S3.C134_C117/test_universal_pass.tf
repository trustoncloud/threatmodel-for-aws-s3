# S3.C117 (replication_metrics_enabled) - universal - COMPLIANT (0 findings)

resource "aws_s3_bucket_replication_configuration" "with_metrics" {
  bucket = "source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "replicate-with-metrics"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::replica-bucket"

      metrics {
        status = "Enabled"

        event_threshold {
          minutes = 15
        }
      }
    }
  }
}

variable "example_metrics_status" {
  type    = string
  default = "Enabled"
}

# Values given by reference resolve at apply time; the cloud matcher judges them.
resource "aws_s3_bucket_replication_configuration" "metrics_by_reference" {
  bucket = "example-source-bucket-2"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "replicate-with-metrics-by-reference"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::example-replica-bucket-2"

      metrics {
        status = var.example_metrics_status

        event_threshold {
          minutes = 15
        }
      }
    }
  }
}

# Inline replication_configuration block: an explicit Enabled status, and a
# metrics block with no status, which the provider sets to Enabled
resource "aws_s3_bucket" "inline_with_metrics" {
  bucket = "inline-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id       = "inline-metrics-enabled"
      priority = 1
      status   = "Enabled"

      filter {
        prefix = "data/"
      }

      destination {
        bucket = "arn:aws:s3:::replica-bucket"

        metrics {
          status  = "Enabled"
          minutes = 15
        }
      }
    }

    rules {
      id       = "inline-metrics-default"
      priority = 2
      status   = "Enabled"

      filter {
        prefix = "logs/"
      }

      destination {
        bucket = "arn:aws:s3:::replica-bucket-2"

        metrics {
          minutes = 15
        }
      }
    }
  }
}

# Never created (an empty for_each, a literal count of 0): not judged, though
# metrics are off
resource "aws_s3_bucket_replication_configuration" "for_each_empty" {
  for_each = {}
  bucket   = "source-bucket"
  role     = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "metrics-disabled"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::replica-bucket"

      metrics {
        status = "Disabled"
      }
    }
  }
}

resource "aws_s3_bucket" "count_zero_inline" {
  count  = 0
  bucket = "inline-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "inline-metrics-disabled"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::replica-bucket"

        metrics {
          status = "Disabled"
        }
      }
    }
  }
}

variable "example_filter_prefixes" {
  type    = list(string)
  default = ["data/"]
}

# A filter generated by a dynamic block leaves the metrics this rule checks in
# the source
resource "aws_s3_bucket_replication_configuration" "dyn_filter" {
  bucket = "example-source-bucket-3"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "dynamic-filter"
    status = "Enabled"

    dynamic "filter" {
      for_each = var.example_filter_prefixes

      content {
        prefix = filter.value
      }
    }

    delete_marker_replication {
      status = "Disabled"
    }

    destination {
      bucket = "arn:aws:s3:::example-replica-bucket-3"

      metrics {
        status = "Enabled"

        event_threshold {
          minutes = 15
        }
      }
    }
  }
}

# A dynamic block whose for_each is a literal empty collection generates
# nothing and is read as absent: written-out rules with metrics enabled next to an
# empty dynamic rule, in the standalone resource and in the inline block,
# and an inline block an empty dynamic block would generate
resource "aws_s3_bucket_replication_configuration" "nodyn_standalone" {
  bucket = "example-source-bucket-4"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "written-out"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"

      metrics {
        status = "Enabled"
      }
    }
  }

  dynamic "rule" {
    for_each = []

    content {
      id     = "generated"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }
  }
}

resource "aws_s3_bucket" "nodyn_inline" {
  bucket = "example-inline-source-bucket-4"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "written-out"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"

          metrics {
            status = "Enabled"
          }
      }
    }

    dynamic "rules" {
      for_each = toset([])

      content {
        id     = "generated"
        status = "Enabled"

        destination {
          bucket = "arn:aws:s3:::authorized-replica-bucket"
        }
      }
    }
  }
}

resource "aws_s3_bucket" "nodyn_whole" {
  bucket = "example-dynamic-whole-bucket"

  dynamic "replication_configuration" {
    for_each = {}

    content {
      role = "arn:aws:iam::999999999999:role/rogue-replication-role"

      rules {
        id     = "generated"
        status = "Enabled"

        destination {
          bucket = "arn:aws:s3:::rogue-replica-bucket"
        }
      }
    }
  }
}
