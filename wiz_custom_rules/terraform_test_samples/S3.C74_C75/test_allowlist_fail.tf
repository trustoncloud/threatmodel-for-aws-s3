# S3.C75 (bucket_object_lock_default) - allowlist - VIOLATING

# WORM bucket without Object Lock: 1 finding
resource "aws_s3_bucket" "unlocked" {
  bucket = "worm-audit-bucket"
}

# WORM bucket with Object Lock switched off: 1 finding
resource "aws_s3_bucket" "lockoff" {
  bucket              = "worm-audit-bucket"
  object_lock_enabled = false
}

# WORM bucket with Object Lock but no default retention: 1 finding
resource "aws_s3_bucket" "nodefault" {
  bucket              = "worm-audit-bucket"
  object_lock_enabled = true
}

# WORM bucket whose deprecated inline block enables Object Lock with no rule: 1 finding
resource "aws_s3_bucket" "inlinenorule" {
  bucket = "worm-audit-bucket"

  object_lock_configuration {
    object_lock_enabled = "Enabled"
  }
}

# WORM bucket whose only configuration is never created: 1 finding
resource "aws_s3_bucket" "ghostlock" {
  bucket              = "worm-audit-bucket"
  object_lock_enabled = true
}

resource "aws_s3_bucket_object_lock_configuration" "ghostlock" {
  count  = 0
  bucket = aws_s3_bucket.ghostlock.id

  rule {
    default_retention {
      mode = "GOVERNANCE"
      days = 730
    }
  }
}

# Standalone configuration with no rule: 1 finding
resource "aws_s3_bucket" "holder" {
  bucket              = "worm-records-bucket"
  object_lock_enabled = true
}

resource "aws_s3_bucket_object_lock_configuration" "holder" {
  bucket = aws_s3_bucket.holder.id
}

# Standalone default in the other mode: 1 finding
resource "aws_s3_bucket" "governed" {
  bucket              = "worm-records-bucket"
  object_lock_enabled = true
}

resource "aws_s3_bucket_object_lock_configuration" "governed" {
  bucket = aws_s3_bucket.governed.id

  rule {
    default_retention {
      mode = "GOVERNANCE"
      days = 365
    }
  }
}

# Standalone default of 30 days against a 365-day minimum: 1 finding
resource "aws_s3_bucket" "thirtyday" {
  bucket              = "worm-records-bucket"
  object_lock_enabled = true
}

resource "aws_s3_bucket_object_lock_configuration" "thirtyday" {
  bucket = aws_s3_bucket.thirtyday.id

  rule {
    default_retention {
      mode = "COMPLIANCE"
      days = 30
    }
  }
}

# Standalone default one day short, bucket named by its literal name: 1 finding
resource "aws_s3_bucket_object_lock_configuration" "dayshort" {
  bucket = "worm-records-bucket"

  rule {
    default_retention {
      mode = "COMPLIANCE"
      days = 364
    }
  }
}

# Standalone default of 1 year (365 days) against a 730-day minimum: 1 finding
resource "aws_s3_bucket" "oneyear" {
  bucket              = "worm-audit-bucket"
  object_lock_enabled = true
}

resource "aws_s3_bucket_object_lock_configuration" "oneyear" {
  bucket = aws_s3_bucket.oneyear.id

  rule {
    default_retention {
      mode  = "GOVERNANCE"
      years = 1
    }
  }
}

# Deprecated inline default in the other mode: 1 finding
resource "aws_s3_bucket" "inlinemode" {
  bucket = "worm-audit-bucket"

  object_lock_configuration {
    object_lock_enabled = "Enabled"

    rule {
      default_retention {
        mode  = "COMPLIANCE"
        years = 2
      }
    }
  }
}

# Deprecated inline default too short: 1 finding
resource "aws_s3_bucket" "inlineshort" {
  bucket = "worm-audit-bucket"

  object_lock_configuration {
    object_lock_enabled = "Enabled"

    rule {
      default_retention {
        mode = "GOVERNANCE"
        days = 90
      }
    }
  }
}

# A default retention generated by a dynamic block cannot be read: 1 finding each
resource "aws_s3_bucket" "dynlockblock" {
  bucket = "worm-audit-bucket"

  dynamic "object_lock_configuration" {
    for_each = ["on"]
    content {
      object_lock_enabled = "Enabled"
    }
  }
}

resource "aws_s3_bucket" "dyninlinelock" {
  bucket = "worm-audit-bucket"

  object_lock_configuration {
    object_lock_enabled = "Enabled"

    dynamic "rule" {
      for_each = ["GOVERNANCE"]
      content {
        default_retention {
          mode  = rule.value
          years = 2
        }
      }
    }
  }
}

resource "aws_s3_bucket_object_lock_configuration" "dynlockrule" {
  bucket = "worm-records-bucket"

  dynamic "rule" {
    for_each = ["COMPLIANCE"]
    content {
      default_retention {
        mode = rule.value
        days = 365
      }
    }
  }
}

resource "aws_s3_bucket_object_lock_configuration" "dynretention" {
  bucket = "worm-records-bucket"

  rule {
    dynamic "default_retention" {
      for_each = ["COMPLIANCE"]
      content {
        mode = default_retention.value
        days = 365
      }
    }
  }
}
