# S3.C87 (replication_source_check) - allowlist - COMPLIANT (0 findings)

# Authorized bucket replicating, named through a bucket reference
resource "aws_s3_bucket" "authsource" {
  bucket = "authorized-source-bucket"
}

resource "aws_s3_bucket_replication_configuration" "authsource" {
  bucket = aws_s3_bucket.authsource.id
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "to-replica"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

# Unlisted bucket whose only replication rule is disabled
resource "aws_s3_bucket_replication_configuration" "paused" {
  bucket = "paused-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "paused"
    status = "Disabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

# Authorized bucket replicating through the inline replication_configuration block
resource "aws_s3_bucket" "authsource_inline" {
  bucket = "authorized-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "to-replica"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }
  }
}

# Unlisted bucket whose only inline replication rule is disabled
resource "aws_s3_bucket" "paused_inline" {
  bucket = "paused-inline-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "paused"
      status = "Disabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }
  }
}

# Inline block on a bucket whose name is chosen at apply is not judged
resource "aws_s3_bucket" "prefixed_inline" {
  bucket_prefix = "generated-"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "to-replica"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }
  }
}

# Never created (a literal count of 0 or an empty for_each): not judged,
# though the bucket is not on the list
resource "aws_s3_bucket_replication_configuration" "count_zero" {
  count  = 0
  bucket = "unlisted-source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "to-replica"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

resource "aws_s3_bucket_replication_configuration" "for_each_empty" {
  for_each = toset([])
  bucket   = "unlisted-source-bucket"
  role     = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "to-replica"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

resource "aws_s3_bucket" "count_zero_inline" {
  count  = 0
  bucket = "unlisted-inline-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "to-replica"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }
  }
}

variable "example_replication_rules" {
  type = list(object({ id = string, destination_bucket = string }))
  default = [
    {
      id                 = "to-archive"
      destination_bucket = "arn:aws:s3:::authorized-archive-bucket"
    },
  ]
}

# Rules generated by a dynamic block on an authorized bucket: this rule asks
# only whether the bucket may replicate, so the rules need not be read
resource "aws_s3_bucket_replication_configuration" "dyn_authorized" {
  bucket = "authorized-source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  dynamic "rule" {
    for_each = var.example_replication_rules

    content {
      id     = rule.value.id
      status = "Enabled"

      destination {
        bucket = rule.value.destination_bucket
      }
    }
  }
}

# A dynamic block whose for_each is a literal empty collection generates
# nothing and is read as absent: unlisted buckets whose only written-out rule
# is disabled, in the standalone resource and in the inline block, and an
# unlisted bucket whose inline block an empty dynamic block would generate
resource "aws_s3_bucket_replication_configuration" "nodyn_standalone" {
  bucket = "paused-dynamic-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "written-out"
    status = "Disabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }

  dynamic "rule" {
    for_each = []

    content {
      id     = "generated"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }
  }
}

resource "aws_s3_bucket" "nodyn_inline" {
  bucket = "paused-dynamic-inline-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "written-out"
      status = "Disabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }

    dynamic "rules" {
      for_each = toset([])

      content {
        id     = "generated"
        status = "Enabled"

        destination {
          bucket = "arn:aws:s3:::authorized-replica-bucket"
        }
      }
    }
  }
}

resource "aws_s3_bucket" "nodyn_whole" {
  bucket = "unlisted-dynamic-whole-bucket"

  dynamic "replication_configuration" {
    for_each = {}

    content {
      role = "arn:aws:iam::999999999999:role/rogue-replication-role"

      rules {
        id     = "generated"
        status = "Enabled"

        destination {
          bucket = "arn:aws:s3:::rogue-replica-bucket"
        }
      }
    }
  }
}
