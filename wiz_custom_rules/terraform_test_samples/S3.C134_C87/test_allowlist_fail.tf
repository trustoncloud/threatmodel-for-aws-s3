# S3.C87 (replication_source_check) - allowlist - VIOLATING

# Unlisted bucket replicating, named as a literal: 1 finding
resource "aws_s3_bucket_replication_configuration" "rogue" {
  bucket = "rogue-source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "to-replica"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

# Unlisted bucket replicating, named through a bucket reference: 1 finding
resource "aws_s3_bucket" "unlisted" {
  bucket = "unlisted-source-bucket"
}

resource "aws_s3_bucket_replication_configuration" "unlisted" {
  bucket = aws_s3_bucket.unlisted.id
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "to-replica"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

# Unlisted bucket replicating through the inline replication_configuration
# block, one rule enabled and one disabled: 1 finding
resource "aws_s3_bucket" "rogue_inline" {
  bucket = "rogue-inline-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id       = "paused"
      priority = 1
      status   = "Disabled"

      filter {
        prefix = "old/"
      }

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }

    rules {
      id       = "to-replica"
      priority = 2
      status   = "Enabled"

      filter {
        prefix = "data/"
      }

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }
  }
}

# Lookalike of the authorized name, declared inline: 1 finding
resource "aws_s3_bucket" "lookalike_inline" {
  bucket = "authorized-source-bucket-rogue"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    rules {
      id     = "to-replica"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::authorized-replica-bucket"
      }
    }
  }
}

# Unlisted bucket replicating, created through count and through for_each: 2 findings
resource "aws_s3_bucket_replication_configuration" "count_one" {
  count  = 1
  bucket = "counted-source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "to-replica"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

resource "aws_s3_bucket_replication_configuration" "for_each_one" {
  for_each = toset(["primary"])
  bucket   = "for-each-source-bucket"
  role     = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "to-replica"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

variable "example_enable_replication" {
  type    = bool
  default = false
}

# Unlisted bucket replicating with a count from a variable, known only at
# plan time, so it is judged even with a default of false: 1 finding
resource "aws_s3_bucket_replication_configuration" "count_from_variable" {
  count  = var.example_enable_replication ? 1 : 0
  bucket = "variable-source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  rule {
    id     = "to-replica"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::authorized-replica-bucket"
    }
  }
}

variable "example_unknown_replication_rules" {
  type = list(object({ id = string, destination_bucket = string }))
}

variable "example_replication_configuration" {
  type = list(object({ role = string, destination_bucket = string }))
}

# Unlisted buckets whose replication rules are generated by a dynamic block,
# which cannot be judged: in the standalone resource, in the inline block,
# and as a whole inline block: 3 findings
resource "aws_s3_bucket_replication_configuration" "dyn_standalone" {
  bucket = "dynamic-source-bucket"
  role   = "arn:aws:iam::123456789012:role/replication-role"

  dynamic "rule" {
    for_each = var.example_unknown_replication_rules

    content {
      id     = rule.value.id
      status = "Enabled"

      destination {
        bucket = rule.value.destination_bucket
      }
    }
  }
}

resource "aws_s3_bucket" "dyn_rules_inline" {
  bucket = "dynamic-inline-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/replication-role"

    dynamic "rules" {
      for_each = var.example_unknown_replication_rules

      content {
        id     = rules.value.id
        status = "Enabled"

        destination {
          bucket = rules.value.destination_bucket
        }
      }
    }
  }
}

resource "aws_s3_bucket" "dyn_whole" {
  bucket = "dynamic-whole-source-bucket"

  dynamic "replication_configuration" {
    for_each = var.example_replication_configuration

    content {
      role = replication_configuration.value.role

      rules {
        id     = "to-replica"
        status = "Enabled"

        destination {
          bucket = replication_configuration.value.destination_bucket
        }
      }
    }
  }
}
