# S3.C95 (notification_receiver_check) - allowlist - VIOLATING

# Unauthorized topic, queue, and lambda receivers: 3 findings
resource "aws_s3_bucket_notification" "rogue_receivers" {
  bucket = "notify-bucket"

  topic {
    topic_arn = "arn:aws:sns:us-east-1:999999999999:rogue-topic"
    events    = ["s3:ObjectCreated:*"]
  }

  queue {
    queue_arn = "arn:aws:sqs:us-east-1:999999999999:rogue-queue"
    events    = ["s3:ObjectRemoved:*"]
  }

  lambda_function {
    lambda_function_arn = "arn:aws:lambda:us-east-1:999999999999:function:rogue-function"
    events              = ["s3:ObjectCreated:Put"]
  }
}

# EventBridge delivery from a bucket that is not listed: 1 finding
resource "aws_s3_bucket_notification" "eventbridge_unlisted" {
  bucket      = "unlisted-bucket"
  eventbridge = true
}

# EventBridge delivery from a name that only looks like a listed bucket: 1 finding
resource "aws_s3_bucket_notification" "eventbridge_lookalike" {
  bucket      = "authorized-eventbridge-bucket-rogue"
  eventbridge = true
}

# The same, with the bucket given by reference: 1 finding
resource "aws_s3_bucket" "events_lookalike" {
  bucket = "xauthorized-eventbridge-bucket"
}

resource "aws_s3_bucket_notification" "eventbridge_lookalike_by_reference" {
  bucket      = aws_s3_bucket.events_lookalike.bucket
  eventbridge = true
}

# Unauthorized queue on a notification created through count: 1 finding
resource "aws_s3_bucket_notification" "count_one" {
  count  = 1
  bucket = "notify-bucket"

  queue {
    queue_arn = "arn:aws:sqs:us-east-1:999999999999:rogue-queue"
    events    = ["s3:ObjectCreated:*"]
  }
}

variable "example_unknown_receiver_arns" {
  type = list(string)
}

# Topic, queue and lambda_function receivers generated by dynamic blocks,
# which cannot be compared: 3 findings
resource "aws_s3_bucket_notification" "dyn_receivers" {
  bucket = "notify-bucket"

  dynamic "topic" {
    for_each = var.example_unknown_receiver_arns

    content {
      topic_arn = topic.value
      events    = ["s3:ObjectCreated:*"]
    }
  }

  dynamic "queue" {
    for_each = var.example_unknown_receiver_arns

    content {
      queue_arn = queue.value
      events    = ["s3:ObjectRemoved:*"]
    }
  }

  dynamic "lambda_function" {
    for_each = var.example_unknown_receiver_arns

    content {
      lambda_function_arn = lambda_function.value
      events              = ["s3:ObjectCreated:Put"]
    }
  }
}
