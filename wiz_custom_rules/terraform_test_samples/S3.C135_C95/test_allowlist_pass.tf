# S3.C95 (notification_receiver_check) - allowlist - COMPLIANT (0 findings)

resource "aws_s3_bucket_notification" "authorized_receivers" {
  bucket = "notify-bucket"

  topic {
    topic_arn = "arn:aws:sns:us-east-1:123456789012:authorized-topic"
    events    = ["s3:ObjectCreated:*"]
  }

  queue {
    queue_arn = "arn:aws:sqs:us-east-1:123456789012:authorized-queue"
    events    = ["s3:ObjectRemoved:*"]
  }
}

variable "example_topic_arn" {
  type    = string
  default = "arn:aws:sns:us-east-1:123456789012:authorized-topic"
}

variable "example_queue_arn" {
  type    = string
  default = "arn:aws:sqs:us-east-1:123456789012:authorized-queue"
}

variable "example_function_arn" {
  type    = string
  default = "arn:aws:lambda:us-east-1:123456789012:function:authorized-function"
}

# Values given by reference resolve at apply time; the cloud matcher judges them.
resource "aws_s3_bucket_notification" "receivers_by_reference" {
  bucket = "example-notify-bucket-2"

  topic {
    topic_arn = var.example_topic_arn
    events    = ["s3:ObjectCreated:*"]
  }

  queue {
    queue_arn = var.example_queue_arn
    events    = ["s3:ObjectRemoved:*"]
  }

  lambda_function {
    lambda_function_arn = var.example_function_arn
    events              = ["s3:ObjectCreated:Put"]
  }
}

# EventBridge delivery from listed buckets, named literally and by reference
resource "aws_s3_bucket_notification" "eventbridge_listed" {
  bucket      = "authorized-eventbridge-bucket"
  eventbridge = true
}

resource "aws_s3_bucket" "events_archive" {
  bucket = "authorized-events-archive-bucket"
}

resource "aws_s3_bucket_notification" "eventbridge_listed_by_reference" {
  bucket      = aws_s3_bucket.events_archive.id
  eventbridge = true
}

# EventBridge explicitly off on a bucket that is not listed
resource "aws_s3_bucket_notification" "eventbridge_off" {
  bucket      = "unlisted-bucket"
  eventbridge = false

  queue {
    queue_arn = "arn:aws:sqs:us-east-1:123456789012:authorized-queue"
    events    = ["s3:ObjectCreated:*"]
  }
}

# A bucket named only at apply is not compared; the cloud matcher judges it.
resource "aws_s3_bucket" "generated_name" {
  bucket_prefix = "events-"
}

resource "aws_s3_bucket_notification" "eventbridge_name_at_apply" {
  bucket      = aws_s3_bucket.generated_name.id
  eventbridge = true
}

# Never created (a literal count of 0, an empty for_each): not judged, though
# the receiver is not authorized and the bucket is not on the EventBridge list
resource "aws_s3_bucket_notification" "count_zero" {
  count  = 0
  bucket = "notify-bucket"

  topic {
    topic_arn = "arn:aws:sns:us-east-1:999999999999:rogue-topic"
    events    = ["s3:ObjectCreated:*"]
  }
}

resource "aws_s3_bucket_notification" "for_each_empty" {
  for_each    = toset([])
  bucket      = "unlisted-bucket"
  eventbridge = true
}

# A dynamic block whose for_each is a literal empty collection generates
# nothing and is read as absent: an authorized queue written out
# next to an empty dynamic topic block
resource "aws_s3_bucket_notification" "nodyn_topic" {
  bucket = "notify-bucket"

  queue {
    queue_arn = "arn:aws:sqs:us-east-1:123456789012:authorized-queue"
    events    = ["s3:ObjectCreated:*"]
  }

  dynamic "topic" {
    for_each = []

    content {
      topic_arn = "arn:aws:sns:us-east-1:999999999999:rogue-topic"
      events    = ["s3:ObjectCreated:*"]
    }
  }
}

variable "example_receiver_arns" {
  type    = list(string)
  default = ["arn:aws:sqs:us-east-1:123456789012:authorized-queue"]
}

# Never created (a literal count of 0): not judged, though its receivers are
# generated by a dynamic block
resource "aws_s3_bucket_notification" "zerodynamic" {
  count  = 0
  bucket = "notify-bucket"

  dynamic "queue" {
    for_each = var.example_receiver_arns

    content {
      queue_arn = queue.value
      events    = ["s3:ObjectCreated:*"]
    }
  }
}
