# S3.C97 (inventory_destination_check) - allowlist - VIOLATING

# Inventory reports sent to an unauthorized bucket: 1 finding
resource "aws_s3_bucket_inventory" "rogue_destination" {
  bucket                   = "inventoried-bucket"
  name                     = "exfil-inventory"
  included_object_versions = "All"

  schedule {
    frequency = "Daily"
  }

  destination {
    bucket {
      bucket_arn = "arn:aws:s3:::rogue-inventory-bucket"
      format     = "CSV"
    }
  }
}

# Unauthorized destination on an inventory created through for_each: 1 finding
resource "aws_s3_bucket_inventory" "for_each_one" {
  for_each                 = toset(["weekly"])
  bucket                   = "inventoried-bucket"
  name                     = "exfil-inventory-${each.key}"
  included_object_versions = "All"

  schedule {
    frequency = "Weekly"
  }

  destination {
    bucket {
      bucket_arn = "arn:aws:s3:::rogue-inventory-bucket"
      format     = "CSV"
    }
  }
}

variable "example_inventory_destinations" {
  type = list(string)
}

# Destination generated by a dynamic block, as the destination block and as
# its bucket block, which cannot be compared: 2 findings
resource "aws_s3_bucket_inventory" "dyn_destination" {
  bucket                   = "inventoried-bucket"
  name                     = "dynamic-destination-inventory"
  included_object_versions = "All"

  schedule {
    frequency = "Weekly"
  }

  dynamic "destination" {
    for_each = var.example_inventory_destinations

    content {
      bucket {
        bucket_arn = destination.value
        format     = "CSV"
      }
    }
  }
}

resource "aws_s3_bucket_inventory" "dyn_dest_bucket" {
  bucket                   = "inventoried-bucket"
  name                     = "dynamic-bucket-inventory"
  included_object_versions = "All"

  schedule {
    frequency = "Weekly"
  }

  destination {
    dynamic "bucket" {
      for_each = var.example_inventory_destinations

      content {
        bucket_arn = bucket.value
        format     = "CSV"
      }
    }
  }
}
