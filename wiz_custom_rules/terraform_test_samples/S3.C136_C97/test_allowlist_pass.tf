# S3.C97 (inventory_destination_check) - allowlist - COMPLIANT (0 findings)

resource "aws_s3_bucket_inventory" "authorized_destination" {
  bucket                   = "inventoried-bucket"
  name                     = "weekly-inventory"
  included_object_versions = "All"

  schedule {
    frequency = "Weekly"
  }

  destination {
    bucket {
      bucket_arn = "arn:aws:s3:::authorized-inventory-bucket"
      format     = "CSV"
      account_id = "123456789012"
    }
  }
}

variable "example_inventory_bucket_arn" {
  type    = string
  default = "arn:aws:s3:::authorized-inventory-bucket"
}

# Values given by reference resolve at apply time; the cloud matcher judges them.
resource "aws_s3_bucket_inventory" "destination_by_reference" {
  bucket                   = "inventoried-bucket"
  name                     = "weekly-inventory-by-reference"
  included_object_versions = "All"

  schedule {
    frequency = "Weekly"
  }

  destination {
    bucket {
      bucket_arn = var.example_inventory_bucket_arn
      format     = "CSV"
      account_id = "123456789012"
    }
  }
}

# Never created (a literal count of 0): not judged, though the destination is
# not authorized
resource "aws_s3_bucket_inventory" "count_zero" {
  count                    = 0
  bucket                   = "inventoried-bucket"
  name                     = "never-created-inventory"
  included_object_versions = "All"

  schedule {
    frequency = "Daily"
  }

  destination {
    bucket {
      bucket_arn = "arn:aws:s3:::rogue-inventory-bucket"
      format     = "CSV"
    }
  }
}

variable "example_inventory_prefixes" {
  type    = list(string)
  default = ["data/"]
}

# A filter generated by a dynamic block leaves the destination in the source
resource "aws_s3_bucket_inventory" "dyn_filter" {
  bucket                   = "inventoried-bucket"
  name                     = "dynamic-filter-inventory"
  included_object_versions = "All"

  schedule {
    frequency = "Weekly"
  }

  dynamic "filter" {
    for_each = var.example_inventory_prefixes

    content {
      prefix = filter.value
    }
  }

  destination {
    bucket {
      bucket_arn = "arn:aws:s3:::authorized-inventory-bucket"
      format     = "CSV"
    }
  }
}
