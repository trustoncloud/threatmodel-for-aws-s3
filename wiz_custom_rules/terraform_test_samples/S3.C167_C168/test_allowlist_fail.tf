# S3.C168 (ssec_conditional_blocking) - allowlist - VIOLATING

# Required bucket whose default encryption setting blocks SSE-C: 1 finding
resource "aws_s3_bucket" "ssecset" {
  bucket = "ssec-required-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "ssecset" {
  bucket = aws_s3_bucket.ssecset.id

  rule {
    blocked_encryption_types = ["SSE-C"]
  }
}

# Required bucket that does not set blocked_encryption_types: 1 finding
resource "aws_s3_bucket" "ssecmissing" {
  bucket = "ssec-required-bucket"
}

# Ordinary bucket with no SSE-C block at all: 1 finding
resource "aws_s3_bucket" "ordinary" {
  bucket = "ordinary-bucket"
}

# Ordinary bucket explicitly allowing SSE-C: 1 finding
resource "aws_s3_bucket" "ordnone" {
  bucket = "ordnone-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "ordnone" {
  bucket = aws_s3_bucket.ordnone.id

  rule {
    blocked_encryption_types = ["NONE"]
  }
}

# Ordinary bucket blocking SSE-C only through its bucket policy: 1 finding
resource "aws_s3_bucket" "ordpolicy" {
  bucket = "ordpolicy-bucket"
}

resource "aws_s3_bucket_policy" "ordpolicy" {
  bucket = aws_s3_bucket.ordpolicy.id
  policy = <<POLICY
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Deny",
      "Principal": "*",
      "Action": "s3:PutObject",
      "Resource": "arn:aws:s3:::ordpolicy-bucket/*",
      "Condition": {
        "Null": { "s3:x-amz-server-side-encryption-customer-algorithm": "false" }
      }
    }
  ]
}
POLICY
}

# Bucket with a required path whose setting blocks SSE-C bucket-wide: 1 finding
resource "aws_s3_bucket" "mixedbad" {
  bucket = "mixed-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "mixedbad" {
  bucket = aws_s3_bucket.mixedbad.id

  rule {
    blocked_encryption_types = ["SSE-C"]
  }
}

variable "example_referenced_bucket_name" {
  type    = string
  default = "example-named-by-reference-bucket"
}

# Bucket named by reference with no SSE-C setting, which fails whichever group
# it is in: 1 finding
resource "aws_s3_bucket" "name_by_reference" {
  bucket = var.example_referenced_bucket_name
}

# Ordinary bucket whose only SSE-C block is in a configuration that is never
# created (a literal count of 0): 1 finding
resource "aws_s3_bucket" "ordzero" {
  bucket = "ordzero-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "ordzero" {
  count  = 0
  bucket = aws_s3_bucket.ordzero.id

  rule {
    blocked_encryption_types = ["SSE-C"]
  }
}

# Required bucket whose only setting allowing SSE-C is in a configuration that
# is never created (an empty for_each): 1 finding
resource "aws_s3_bucket" "ssecempty" {
  bucket = "ssec-required-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "ssecempty" {
  for_each = toset([])
  bucket   = aws_s3_bucket.ssecempty.id

  rule {
    blocked_encryption_types = ["NONE"]
  }
}

variable "example_encryption_rules" {
  type = list(object({ blocked_encryption_types = list(string) }))
}

# Blocked encryption types in a rule generated by a dynamic block, which
# cannot be read, on an ordinary bucket and on a bucket that requires SSE-C:
# 2 findings
resource "aws_s3_bucket" "dynrule" {
  bucket = "dynrule-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "dynrule" {
  bucket = aws_s3_bucket.dynrule.id

  dynamic "rule" {
    for_each = var.example_encryption_rules

    content {
      blocked_encryption_types = rule.value.blocked_encryption_types
    }
  }
}

resource "aws_s3_bucket" "ssecdyn" {
  bucket = "ssec-required-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "ssecdyn" {
  bucket = aws_s3_bucket.ssecdyn.id

  dynamic "rule" {
    for_each = var.example_encryption_rules

    content {
      blocked_encryption_types = rule.value.blocked_encryption_types
    }
  }
}
