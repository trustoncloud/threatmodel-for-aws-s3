# S3.C168 (ssec_conditional_blocking) - allowlist - COMPLIANT (0 findings)

# Ordinary bucket blocking SSE-C through its default encryption setting
resource "aws_s3_bucket" "ordsetting" {
  bucket = "ordsetting-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "ordsetting" {
  bucket = aws_s3_bucket.ordsetting.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
    blocked_encryption_types = ["SSE-C"]
  }
}

# Required bucket explicitly allowing SSE-C
resource "aws_s3_bucket" "ssec_required" {
  bucket = "ssec-required-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "ssec_required" {
  bucket = aws_s3_bucket.ssec_required.id

  rule {
    apply_server_side_encryption_by_default {
      sse_algorithm = "AES256"
    }
    blocked_encryption_types = ["NONE"]
  }
}

# Bucket with a required path (mixed-bucket/secure/) explicitly allowing SSE-C
resource "aws_s3_bucket" "mixedok" {
  bucket = "mixed-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "mixedok" {
  bucket = aws_s3_bucket.mixedok.id

  rule {
    blocked_encryption_types = ["NONE"]
  }
}

variable "example_bucket_name" {
  type    = string
  default = "ssec-required-bucket"
}

variable "example_blocked_encryption_types" {
  type    = list(string)
  default = ["SSE-C"]
}

# Values given by reference resolve at apply time; the cloud matcher judges them.
# A bucket named by reference that explicitly allows SSE-C may be one that
# requires it.
resource "aws_s3_bucket" "name_by_reference" {
  bucket = var.example_bucket_name
}

resource "aws_s3_bucket_server_side_encryption_configuration" "name_by_reference" {
  bucket = aws_s3_bucket.name_by_reference.id

  rule {
    blocked_encryption_types = ["NONE"]
  }
}

# Values given by reference resolve at apply time; the cloud matcher judges them.
resource "aws_s3_bucket" "types_by_reference" {
  bucket = "example-types-by-reference-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "types_by_reference" {
  bucket = aws_s3_bucket.types_by_reference.id

  rule {
    blocked_encryption_types = var.example_blocked_encryption_types
  }
}

# Never created (a literal count of 0): not judged, though nothing blocks
# SSE-C
resource "aws_s3_bucket" "ordunbuilt" {
  count  = 0
  bucket = "ordunbuilt-bucket"
}

variable "example_sse_algorithms" {
  type    = list(string)
  default = ["AES256"]
}

# A default encryption block generated by a dynamic block leaves
# blocked_encryption_types in the source
resource "aws_s3_bucket" "dynalgo" {
  bucket = "dynalgo-bucket"
}

resource "aws_s3_bucket_server_side_encryption_configuration" "dynalgo" {
  bucket = aws_s3_bucket.dynalgo.id

  rule {
    dynamic "apply_server_side_encryption_by_default" {
      for_each = var.example_sse_algorithms

      content {
        sse_algorithm = apply_server_side_encryption_by_default.value
      }
    }

    blocked_encryption_types = ["SSE-C"]
  }
}
