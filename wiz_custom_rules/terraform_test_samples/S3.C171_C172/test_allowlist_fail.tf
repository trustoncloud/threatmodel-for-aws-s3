# S3.C172 (bucket_abac_configuration) - allowlist - VIOLATING

# ABAC enabled on a bucket not authorized for it: 1 finding
resource "aws_s3_bucket" "unauthorized" {
  bucket = "example-unauthorized-abac-bucket"
}

resource "aws_s3_bucket_abac" "unauthorized" {
  bucket = aws_s3_bucket.unauthorized.id

  abac_status {
    status = "Enabled"
  }
}

# ABAC disabled on an authorized bucket: 1 finding
resource "aws_s3_bucket" "authorized" {
  bucket = "authorized-abac-bucket"
}

resource "aws_s3_bucket_abac" "authorized" {
  bucket = aws_s3_bucket.authorized.bucket

  abac_status {
    status = "Disabled"
  }
}

# Authorized bucket with no aws_s3_bucket_abac, so ABAC is off: 1 finding
resource "aws_s3_bucket" "reports" {
  bucket = "authorized-abac-reports"
}

# Authorized bucket whose only aws_s3_bucket_abac is never created (a literal
# count of 0), so ABAC is off: 1 finding
resource "aws_s3_bucket" "zeroabac" {
  bucket = "authorized-abac-reports"
}

resource "aws_s3_bucket_abac" "zeroabac" {
  count  = 0
  bucket = aws_s3_bucket.zeroabac.bucket

  abac_status {
    status = "Enabled"
  }
}

variable "example_unknown_abac_statuses" {
  type = list(string)
}

# abac_status generated by a dynamic block, which cannot be judged, on a
# bucket not authorized for ABAC and on an authorized one: 2 findings
resource "aws_s3_bucket_abac" "dynstatus_rogue" {
  bucket = "example-dynamic-abac-bucket"

  dynamic "abac_status" {
    for_each = var.example_unknown_abac_statuses

    content {
      status = abac_status.value
    }
  }
}

resource "aws_s3_bucket_abac" "dynstatus_listed" {
  bucket = "authorized-abac-bucket"

  dynamic "abac_status" {
    for_each = var.example_unknown_abac_statuses

    content {
      status = abac_status.value
    }
  }
}
