# S3.C92 (replication_role_check) - allowlist - COMPLIANT (0 findings)

# Role listed for the source bucket, bucket named as a literal
resource "aws_s3_bucket_replication_configuration" "authorized_role" {
  bucket = "authorized-source-bucket"
  role   = "arn:aws:iam::123456789012:role/authorized-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

# Role listed for the source bucket, bucket named through a bucket reference
resource "aws_s3_bucket" "authsource" {
  bucket = "authorized-source-bucket"
}

resource "aws_s3_bucket_replication_configuration" "authorized_role_by_bucket_reference" {
  bucket = aws_s3_bucket.authsource.id
  role   = "arn:aws:iam::123456789012:role/authorized-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

variable "example_role_arn" {
  type    = string
  default = "arn:aws:iam::123456789012:role/authorized-replication-role"
}

# Values given by reference resolve at apply time; the cloud matcher judges them.
resource "aws_s3_bucket_replication_configuration" "role_by_reference" {
  bucket = "authorized-source-bucket"
  role   = var.example_role_arn

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

# Role listed for the source bucket, set in the inline replication_configuration block
resource "aws_s3_bucket" "authsource_inline" {
  bucket = "authorized-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/authorized-replication-role"

    rules {
      id     = "replicate"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::any-replica-bucket"
      }
    }
  }
}

# Source bucket named at apply, with a role listed for some bucket: left to
# the cloud check, in both forms
resource "aws_s3_bucket" "generated" {
  bucket_prefix = "generated-"
}

resource "aws_s3_bucket_replication_configuration" "generated_source" {
  bucket = aws_s3_bucket.generated.id
  role   = "arn:aws:iam::123456789012:role/authorized-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

resource "aws_s3_bucket" "generated_inline" {
  bucket_prefix = "generated-inline-"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/authorized-replication-role"

    rules {
      id     = "replicate"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::any-replica-bucket"
      }
    }
  }
}

# Never created (an empty for_each, count 0): not judged, though the role is
# not listed
resource "aws_s3_bucket_replication_configuration" "for_each_empty" {
  for_each = toset([])
  bucket   = "authorized-source-bucket"
  role     = "arn:aws:iam::999999999999:role/rogue-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

resource "aws_s3_bucket" "count_zero_inline" {
  count  = 0
  bucket = "authorized-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::999999999999:role/rogue-replication-role"

    rules {
      id     = "replicate"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::any-replica-bucket"
      }
    }
  }
}

variable "example_replication_rules" {
  type = list(object({ id = string, destination_bucket = string }))
  default = [
    {
      id                 = "replicate"
      destination_bucket = "arn:aws:s3:::any-replica-bucket"
    },
  ]
}

# Rules generated by a dynamic block leave the role in the source, where it
# is judged
resource "aws_s3_bucket_replication_configuration" "dyn_rules" {
  bucket = "authorized-source-bucket"
  role   = "arn:aws:iam::123456789012:role/authorized-replication-role"

  dynamic "rule" {
    for_each = var.example_replication_rules

    content {
      id     = rule.value.id
      status = "Enabled"

      destination {
        bucket = rule.value.destination_bucket
      }
    }
  }
}

# A dynamic block whose for_each is a literal empty collection generates
# nothing and is read as absent: no replication configuration is generated, so
# there is no role to judge
resource "aws_s3_bucket" "nodyn_whole" {
  bucket = "unlisted-dynamic-whole-bucket"

  dynamic "replication_configuration" {
    for_each = {}

    content {
      role = "arn:aws:iam::999999999999:role/rogue-replication-role"

      rules {
        id     = "generated"
        status = "Enabled"

        destination {
          bucket = "arn:aws:s3:::rogue-replica-bucket"
        }
      }
    }
  }
}
