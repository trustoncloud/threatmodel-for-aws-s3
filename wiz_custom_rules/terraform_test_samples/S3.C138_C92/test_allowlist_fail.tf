# S3.C92 (replication_role_check) - allowlist - VIOLATING

# Role not listed for the source bucket: 1 finding
resource "aws_s3_bucket_replication_configuration" "rogue_role" {
  bucket = "authorized-source-bucket"
  role   = "arn:aws:iam::999999999999:role/rogue-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

# Role listed for another bucket, used on a bucket with no entry: 1 finding
resource "aws_s3_bucket_replication_configuration" "other_bucket" {
  bucket = "other-source-bucket"
  role   = "arn:aws:iam::123456789012:role/authorized-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

# Listed role name in another partition: 1 finding
resource "aws_s3_bucket_replication_configuration" "other_partition" {
  bucket = "authorized-source-bucket"
  role   = "arn:aws-us-gov:iam::123456789012:role/authorized-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

# Listed role ARN with a region added: 1 finding
resource "aws_s3_bucket_replication_configuration" "with_region" {
  bucket = "authorized-source-bucket"
  role   = "arn:aws:iam:us-east-1:123456789012:role/authorized-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

# Listed role name in another account, set in the inline
# replication_configuration block: 1 finding
resource "aws_s3_bucket" "inline_other_account" {
  bucket = "authorized-source-bucket"

  replication_configuration {
    role = "arn:aws:iam::999999999999:role/authorized-replication-role"

    rules {
      id     = "replicate"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::any-replica-bucket"
      }
    }
  }
}

# Listed role on a bucket whose name only starts with a listed one, set in
# the inline replication_configuration block: 1 finding
resource "aws_s3_bucket" "inline_lookalike_bucket" {
  bucket = "authorized-source-bucket-rogue"

  replication_configuration {
    role = "arn:aws:iam::123456789012:role/authorized-replication-role"

    rules {
      id     = "replicate"
      status = "Enabled"

      destination {
        bucket = "arn:aws:s3:::any-replica-bucket"
      }
    }
  }
}

# Source bucket named at apply, with a role listed for no bucket: 1 finding
resource "aws_s3_bucket" "generated" {
  bucket_prefix = "generated-"
}

resource "aws_s3_bucket_replication_configuration" "generated_source" {
  bucket = aws_s3_bucket.generated.id
  role   = "arn:aws:iam::123456789012:role/unlisted-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

# Role not listed, on a configuration created through for_each: 1 finding
resource "aws_s3_bucket_replication_configuration" "for_each_one" {
  for_each = toset(["primary"])
  bucket   = "authorized-source-bucket"
  role     = "arn:aws:iam::999999999999:role/rogue-replication-role"

  rule {
    id     = "replicate"
    status = "Enabled"

    destination {
      bucket = "arn:aws:s3:::any-replica-bucket"
    }
  }
}

variable "example_replication_configuration" {
  type = list(object({ role = string, destination_bucket = string }))
}

# Inline replication_configuration generated by a dynamic block, so its role
# is not in the source and cannot be judged: 1 finding
resource "aws_s3_bucket" "dyn_whole" {
  bucket = "authorized-source-bucket"

  dynamic "replication_configuration" {
    for_each = var.example_replication_configuration

    content {
      role = replication_configuration.value.role

      rules {
        id     = "to-replica"
        status = "Enabled"

        destination {
          bucket = replication_configuration.value.destination_bucket
        }
      }
    }
  }
}
